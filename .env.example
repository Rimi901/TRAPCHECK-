# TrapCheck environment configuration
# Copy this file to .env and fill in your free API key.
# Get a FREE key at: https://aistudio.google.com/apikey
#
# IMPORTANT: never commit your .env file. The key is read ONLY from here.

GEMINI_API_KEY=your_api_key_here

# Optional: override the model (defaults to a current free-tier flash model)
# GEMINI_MODEL=gemini-2.0-flash
